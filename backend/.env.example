# LinkAlias Backend Environment Variables Example
# Copy this file to .env and configure your local settings

MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=linkalias
HOST=127.0.0.1
PORT=8000

# Authentication Configuration
JWT_SECRET_KEY=your-jwt-secret-key-goes-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
